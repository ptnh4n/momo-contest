# SafePay Agent Backend Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here
# Optional comma-separated keys for multi-key rotation (T13)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_THINKING_LEVEL=LOW
SAFEPAY_ORCHESTRATOR_MODE=auto
SAFEPAY_DB_PATH=./safepay.db
SAFEPAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

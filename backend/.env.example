# SafePay Agent Backend Environment Variables
GEMINI_API_KEY=
# Comma-separated keys across distinct Google Cloud projects for 429 rotation (T13)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=NONE
SAFEPAY_ORCHESTRATOR_MODE=auto
SAFEPAY_DB_PATH=./safepay.db
SAFEPAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
